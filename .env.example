# Copy this file to .env and fill in real values. .env is never committed.

# Local Docker Postgres (only if you use docker compose)
POSTGRES_USER=nordwind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nordwind

# Used by the API (apps/api). With Neon, paste Neon's connection string here.
DATABASE_URL=postgres://nordwind:change-me-local-only@localhost:5432/nordwind
API_PORT=3000

# Signs login tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# AI providers - all optional. A model appears in the app only if its key is set.
# Without any key you still get the offline "Demo model" (development only).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5   (or claude-sonnet-5-5 for harder questions)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Knowledge base: private S3 bucket (create it with infra/terraform, values from `terraform output`).
S3_BUCKET=
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# demo (offline, no key) | mistral | openai
EMBEDDINGS_PROVIDER=demo
